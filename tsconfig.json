{
  // https://nuxt.com/docs/guide/concepts/typescript
  "compilerOptions": {
     "strict": true,
     "esModuleInterop": true,
     "skipLibCheck": true,
     "moduleResolution": "bundler",
     "module": "esnext",
     "target": "es2020",
     "lib": ["es2020", "dom"],
     "types": ["node"]
  },
  "include": ["app/**/*", "server/**/*", "*.ts", "*.js", "*.d.ts"],
  "exclude": ["node_modules", ".nuxt"]
}
